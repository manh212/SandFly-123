  <!-- The title of jump between headings page. [CHAR_LIMIT=NONE]-->
  <string name="jump_between_headings_title">Jump between headings</string>
  <!--
  Source: The description about how to move focus between headings.
  Description: The translation of "navigation" should be the same as navigation_heading. [CHAR_LIMIT=NONE]
  -->
  <string name="jump_between_headings_text">You can also jump between headings on a page.\n\nTo try it now, swipe right with 3 fingers until you hear \"<xliff:g example="headings">%1$s</xliff:g>\". Then, swipe down to find the \"navigation\" heading.</string>
  <!--
  Source: The description about how to move focus between headings.
  Description: The translation of "navigation" should be the same as navigation_heading. [CHAR_LIMIT=NONE]
  -->
  <string name="jump_between_headings_text_pre_r">You can also jump between headings on a page.\n\nTo try it now, swipe down and then up until you hear \"<xliff:g example="headings">%1$s</xliff:g>\". Then, swipe down to find the \"navigation\" heading.</string>
  <!-- A heading text. [CHAR_LIMIT=NONE]-->
  <string name="content_heading">Content</string>
  <!-- The hint about continuing to find heading and button. [CHAR_LIMIT=NONE]-->
  <string name="content_text">Continue to the next heading.</string>
  <!--
  Source: The hint about continuing to find the next button.
  Description: In RTL language, "right" and "left" should be translated reverse. [CHAR_LIMIT=NONE]
  -->
  <string name="find_next_button_text">Swipe right to find the next button.</string>

  <!--
  Source: The hint about continuing to find the finish button in container navigation tutorial.
  Description: In RTL language, "right" and "left" should be translated reverse. [CHAR_LIMIT=NONE]
  -->
  <string name="container_find_finish_button_text">You’ve exited the list of containers. You can add containers to your reading controls anytime for easier access.\n\nSwipe right to find the finish button.</string>

  <!-- The title of jump between containers page. [CHAR_LIMIT=NONE]-->
  <string name="jump_between_container_title">Jump between containers</string>
  <!-- Source: The description about how to move focus between containers. [CHAR_LIMIT=NONE] -->
  <string name="jump_between_containers_text">To exit out of a container, like a list or grid, swipe left or right with 4 fingers. This is useful when you want to move out of a long list of items.\n\nTo try it now, swipe right to enter the list. Then, swipe right with 4 fingers to go to the next container.</string>
  <!-- Source: The description about how to move focus between containers. [CHAR_LIMIT=NONE] -->
  <string name="jump_between_containers_text_pre_r">Exiting out of a container, like a list or grid, is useful when you want to move out of a long list of items.\n\nTo try it now, swipe down and then up until you hear \"<xliff:g example="container">%1$s</xliff:g>\". Then, swipe down to go to the next container.</string>
  <!-- The title of container view in training page. [CHAR_LIMIT=NONE]-->
  <string name="container_tem_title">Container item</string>
  <!--
  Source: The subtext of container view in training page.
  Description: In RTL language, "right" and "left" should be translated reverse. [CHAR_LIMIT=NONE]
  -->
  <string name="container_item_subtext">To go to the next container, swipe right with 4 fingers</string>
  <!--
  Source: The subtext of container view in training page.
  Description: In RTL language, "right" and "left" should be translated reverse. [CHAR_LIMIT=NONE]
  -->
  <string name="container_item_exit_subtext">To exit this container, swipe right with 4 fingers</string>
  <!-- The subtext of container view in training page. [CHAR_LIMIT=NONE]-->
  <string name="container_item_subtext_pre_r">To go to the next container, swipe down</string>
  <!-- The subtext of container view in training page. [CHAR_LIMIT=NONE]-->
  <string name="container_item_exit_subtext_pre_r">To exit this container, swipe down</string>

  <!-- For voice commands pages in tutorial. -->
  <!-- The title of voice commands page. [CHAR_LIMIT=NONE] -->
  <string name="voice_commands_title">Voice commands</string>
  <!-- The description about how to use voice command. [CHAR_LIMIT=NONE]-->
  <string name="voice_commands_text">You can use your voice to control Meridian quickly.\n\nFor example, say a command to change navigation, jump to the next heading, copy text, and more.\n\nTo try it now, swipe right and then up.\n\nTo dictate text instead of typing, assign the Dictate action to a gesture in Meridian settings > Gestures. Dictate has no gesture by default.</string>

  <!-- For screen search pages in tutorial. -->
  <!-- The title of using screen search page. [CHAR_LIMIT=NONE] -->
  <string name="using_screen_search_title">Using screen search</string>
  <!-- The description about how to use screen search. [CHAR_LIMIT=NONE]-->
  <string name="using_screen_search_text">The screen search feature allows you to look for specific content on the screen.\n\nTo try it, open the Meridian menu by tapping with 3 fingers, and find “screen search” in the menu. Type in a keyword, like “next”, to find items with that text on the screen.\n\nTry searching for “next” now to find the next button.</string>
  <!-- The title of navigate by screen search page. [CHAR_LIMIT=NONE] -->
  <string name="screen_search_navigation_title">Navigate by screen search</string>
  <!-- The description about how to use screen search navigation. [CHAR_LIMIT=NONE]-->
  <string name="screen_search_navigation_text">You can quickly move between different search results from screen search after you’ve selected a result.\n\nTo do this, use reading controls by swiping left or right with 3 fingers, and find the item called screen search.\n\nLet’s try it now. Below is a list of 3 buttons, all of them containing the text “action”. Search for “action” using screen search, then navigate by screen search to move between them.</string>
  <!-- The text of buttons in screen search navigation page. [CHAR_LIMIT=NONE]-->
  <string name="screen_search_action_button_1_text">Action 1</string>
  <!-- The text of buttons in screen search navigation page. [CHAR_LIMIT=NONE]-->
  <string name="screen_search_action_button_2_text">Action 2</string>
  <!-- The text of buttons in screen search navigation page. [CHAR_LIMIT=NONE]-->
  <string name="screen_search_action_button_3_text">Action 3</string>

  <!-- For additional tips pages in tutorial. -->
  <!-- The title of making calls page. [CHAR_LIMIT=NONE] -->
  <string name="making_calls_title">Making &#38; receiving calls</string>
  <!-- The description of making a call. [CHAR_LIMIT=NONE]-->
  <string name="making_calls_text">You can call a family member, friend, or business with the phone app on your home screen.\n\nWhen you receive a call, you can double-tap with 2 fingers to answer it.</string>
  <!-- The tip about how to make a call. [CHAR_LIMIT=NONE]-->
  <string name="making_calls_tips">You can also ask Google Assistant to call a number or the name of someone in your contacts</string>
  <!-- The title of sending messages page. [CHAR_LIMIT=NONE] -->
  <string name="sending_messages_title">Sending messages</string>
  <!-- The description of sending messages. [CHAR_LIMIT=NONE]-->
  <string name="sending_messages_text">To send a message, go to your home screen and find a messaging app</string>
  <!-- The tip about how to send messages. [CHAR_LIMIT=NONE]-->
  <string name="sending_message_tips">You can also ask Google Assistant to send a message to a contact or number</string>
  <!-- The title of the "Checking notifications" page. [CHAR_LIMIT=NONE] -->
  <string name="checking_notifications_title">Checking notifications</string>
  <!-- The head description of the "Checking notifications" page. [CHAR_LIMIT=NONE] -->
  <string name="checking_notifications_text_head">Meridian will announce when you get a new notification.</string>
  <!-- The first bullet point description of the "Checking notifications" page. [CHAR_LIMIT=NONE] -->
  <string name="checking_notifications_step_one">First, swipe down with 4 fingers to access the notification.</string>
  <!-- The Second bullet point description of the "Checking notifications" page. [CHAR_LIMIT=NONE] -->
  <string name="checking_notifications_step_two">Then, swipe left or right to navigate within the notification.</string>
  <!-- The tail description of the "Checking notifications" page. [CHAR_LIMIT=NONE] -->
  <string name="checking_notifications_text_tail">You can check which apps have notifications turned on in Settings > Notifications. On the Notifications screen, you can also turn on Meridian\'s notification list to browse recent notifications.</string>
  <!-- The tail description of the "Checking notifications" page's text-to-speech text. [CHAR_LIMIT=NONE] -->
  <string name="checking_notifications_text_tail_tts">You can check which apps have notifications turned on in Settings then Notifications. On the Notifications screen, you can also turn on Meridian\'s notification list to browse recent notifications.</string>
  <!-- The tip of the "Checking notifications" page. [CHAR_LIMIT=NONE] -->
  <string name="checking_notifications_tips">To check your notification history, swipe down with 2 fingers from the top of your screen</string>

  <!-- For more pages in tutorial. -->
  <string name="tutorial_sandfly_direct_key_input_title">Direct key input</string>
  <string name="tutorial_sandfly_direct_key_input_text">With Direct key input, you type by sliding across the keyboard. Move your finger to the key you want, then lift your finger to type it. Keep your finger on a key to use its long-press action, such as an accented letter.\n\nTo turn it on, go to Meridian settings > On-screen keyboard > Typing method and choose Direct key input.</string>
  <string name="tutorial_sandfly_timer_stopwatch_title">Timer and stopwatch</string>
  <string name="tutorial_sandfly_timer_stopwatch_text">Meridian settings > Timer settings gathers the time announcements and the stopwatch. From there, open the Stopwatch screen to set its sounds, vibration, and how often it reminds you how long it has run.\n\nThe Toggle stopwatch action starts or stops the stopwatch. By default, holding the volume up key while the screen is locked does this.</string>
  <string name="tutorial_sandfly_volume_keys_text">Turn on "Meridian manages volume keys" to choose what the volume keys do. There are six actions to assign: a press, a hold, and a hold while the screen is locked, for volume up and for volume down.\n\nBy default, a press changes the volume, and holding volume up while the screen is locked starts or stops the stopwatch.</string>
  <string name="tutorial_sandfly_translate_text">Meridian can translate the last phrase it spoke, using translation that runs on your device. Assign the Translate last spoken utterance action to a gesture in Meridian settings > Gestures, then use that gesture right after Meridian speaks.\n\nYou can choose the languages in Meridian settings > Feedback > Offline translation.</string>
  <string name="tutorial_sandfly_dictate_text">With Dictate, you speak and Meridian writes your words into the current text box.\n\nDictate has no gesture by default. To use it, assign the Dictate action to a gesture in Meridian settings > Gestures. You can choose the speech recognition service in Meridian settings > Dictation.</string>
  <string name="tutorial_sandfly_web_selection_text">On web pages, Meridian can change the reading control by itself, for example to Headings or to Actions, based on what you focus on.\n\nIf you want the reading control to stay where you put it on web pages, turn off "Change reading control in selection mode" in Meridian settings > Reading controls. While it is off, the reading control never changes by itself in web content.</string>
  <string name="tutorial_sandfly_export_diagnostics_text">Nếu có sự cố, hãy xuất nhật ký chẩn đoán và gửi cho người đang hỗ trợ bạn. Vào Cài đặt Meridian &gt; Trợ giúp, rồi tìm phần Nhật ký ở cuối trang. Chọn Xuất nhật ký vào Tải xuống hoặc Sao chép nhật ký.\n\nNhật ký gồm thông tin về thiết bị và ứng dụng, hoạt động gần đây của Meridian và thông tin về các lần sập.</string>
  <string name="tutorial_sandfly_notifications_text">The Notifications screen in Meridian settings shows which apps have notifications turned on.\n\nYou can also turn on "Use Meridian\'s notification list" there. With the list on, you can browse recent notifications and hear each one with its app, time, and text.</string>

  <!-- For image descriptions pages in tutorial. -->
  <!-- General image description tutorial playground page title. [CHAR_LIMIT=NONE] -->
  <string name="image_description_playground_title">Try getting image descriptions</string>
  <!-- General image description tutorial playground page content one. [CHAR_LIMIT=NONE] -->
  <string name="image_description_playground_content_one">When you’re focused on an image, open the Meridian menu and select “Describe image”.\n\nThere’s one photo below. Try getting a description for it.</string>
  <!-- General image description tutorial playground page content two. [CHAR_LIMIT=NONE] -->
  <string name="image_description_playground_content_two">You can change image description settings anytime in Meridian settings > Automatic descriptions.</string>
  <!-- General image description tutorial playground page content two for TTS. [CHAR_LIMIT=NONE] -->
  <string name="image_description_playground_content_two_tts">You can change image description settings anytime in Meridian settings then Automatic descriptions.</string>
  <!-- Image description tutorial playground image content description. [CHAR_LIMIT=NONE] -->
  <string name="image_description_sample_image_content_description">Sample image; tap with 3 fingers to open the Meridian menu and select \"Describe image\" to hear a description.</string>

  <!-- For practice gestures pages in tutorial. -->
  <!-- The title of practicing gesture page. [CHAR_LIMIT=NONE]-->
  <string name="practice_gestures_title">Practice gestures</string>
  <!-- The title of practicing keyboard and gesture page. [CHAR_LIMIT=NONE]-->
  <string name="practice_keyboard_gestures_title">Practice keyboard shortcuts</string>
  <!-- The title of practicing gesture page. [CHAR_LIMIT=NONE]-->
  <string name="pref_gesture_set_key_title">Gesture set</string>
  <!-- The description about how to try gestures. [CHAR_LIMIT=NONE]-->
  <string name="practice_gestures_text">Try any Meridian gesture on this screen to hear what that gesture does.\n\nTap the screen with 2 fingers. Keep practicing by tapping once, twice, or three times with 2, 3, or 4 fingers.\n\nYou can also double-tap and hold with 2, 3, or 4 fingers.</string>
  <!-- The description about how to try gestures. [CHAR_LIMIT=NONE]-->
  <string name="practice_gestures_text_pre_r">Try any Meridian gesture on this screen to hear what that gesture does.\n\nTry any gesture where two swipes form a right angle. For example, swipe down and then right, without lifting your finger in between.</string>
  <!-- The description about how to try keyboard shortcuts and gestures. [CHAR_LIMIT=NONE]-->
  <string name="practice_keyboard_gestures_text">Press a physical keyboard key or key combination to hear what it does. Press Ctrl + W, or Escape to exit.\n\nYou can also practice Meridian gestures here.</string>
  <!-- The text of the first button which lets users try jumping between controls in tutorial. [CHAR_LIMIT=NONE]-->
  <string name="button_1">Button 1</string>
