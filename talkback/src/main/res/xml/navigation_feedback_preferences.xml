<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory
      android:key="pref_navigation_spoken_feedback"
      android:title="@string/title_pref_navigation_spoken_feedback">
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_speak_container_element_positions_default"
        android:key="@string/pref_speak_container_element_positions_key"
        android:summary="@string/summary_speak_container_element_positions"
        android:title="@string/pref_speak_container_element_positions_title" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="false"
        android:key="pref_speak_list_item_ordinals"
        android:summary="@string/summary_speak_list_item_ordinals"
        android:title="@string/title_speak_list_item_ordinals" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_table_speak_row_column_numbers_default"
        android:key="@string/pref_table_speak_row_column_numbers_key"
        android:summary="@string/pref_table_speak_row_column_numbers_summary"
        android:title="@string/pref_table_speak_row_column_numbers_title" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_verbose_scroll_announcement_default"
        android:key="@string/pref_verbose_scroll_announcement_key"
        android:summary="@string/summary_pref_verbose_scroll_announcement"
        android:title="@string/title_pref_verbose_scroll_announcement" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference
        android:defaultValue="@string/pref_window_names_default"
        android:entries="@array/pref_window_names_entries"
        android:entryValues="@array/pref_window_names_values"
        android:key="@string/pref_window_names_key"
        android:summary="%s"
        android:title="@string/title_pref_window_names" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_allow_frequent_content_change_announcement_default"
        android:key="@string/pref_allow_frequent_content_change_announcement_key"
        android:title="@string/pref_allow_frequent_content_change_announcement_title"
        android:summary="@string/summary_pref_allow_frequent_content_change_announcement" />
    <PreferenceCategory
        android:key="@string/pref_table_headers_category_key"
        android:title="@string/pref_table_headers_category_title">
      <ListPreference
          android:defaultValue="@string/pref_table_column_headers_default"
          android:entries="@array/pref_table_column_headers_entries"
          android:entryValues="@array/pref_table_column_headers_values"
          android:key="@string/pref_table_column_headers_key"
          android:summary="%s"
          android:title="@string/pref_table_column_headers_title" />
    </PreferenceCategory>
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
</PreferenceScreen>
