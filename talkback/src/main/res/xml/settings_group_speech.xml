<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory android:key="@string/pref_category_group_speech_key">
    <ListPreference
        android:key="@string/pref_verbosity_preset_key"
        android:title="@string/title_pref_reading_style"
        android:summary="%s"
        android:defaultValue="@string/pref_verbosity_preset_value_default"
        android:entries="@array/pref_verbosity_preset_entries"
        android:entryValues="@array/pref_verbosity_preset_values" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.preference.base.TextToSpeechSettingsFragment"
        android:key="@string/pref_tts_settings_key"
        android:title="@string/tts_preferences_title" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.preference.base.VoiceProfilesFragment"
        android:key="@string/pref_voice_profiles_screen_key"
        android:persistent="false"
        android:title="@string/title_pref_voice_profiles" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.status.StatusReadoutFragment"
        android:key="@string/pref_status_readout_key"
        android:title="@string/title_pref_status_readout" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.preference.base.ScreenAnnouncementsFragment"
        android:key="pref_screen_announcements"
        android:summary="@string/summary_pref_screen_announcements"
        android:title="@string/title_pref_screen_announcements" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference
        android:defaultValue="@string/pref_time_feedback_format_default"
        android:dialogTitle="@string/pref_time_feedback_format_title"
        android:entries="@array/pref_time_feedback_format_entries"
        android:entryValues="@array/pref_time_feedback_format_values"
        android:key="@string/pref_time_feedback_format_key"
        android:summary="%s"
        android:title="@string/pref_time_feedback_format_title" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory
      android:key="pref_spoken_item_information"
      android:title="@string/title_pref_spoken_item_information">
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_a11y_hints_default"
        android:key="@string/pref_a11y_hints_key"
        android:summary="@string/summary_pref_a11y_hints"
        android:title="@string/title_pref_a11y_hints" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_speak_roles_default"
        android:key="@string/pref_speak_roles_key"
        android:summary="@string/pref_speak_roles_summary"
        android:title="@string/pref_speak_roles_title" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.preference.base.ItemDetailsOrderFragment"
        android:key="@string/pref_node_desc_order_key"
        android:persistent="false"
        android:title="@string/pref_node_desc_order_title" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory
      android:key="pref_speech_text_options"
      android:title="@string/title_pref_reading_text">
    <ListPreference
        android:defaultValue="@string/pref_phonetic_letters_mode_default"
        android:dialogTitle="@string/title_pref_phonetic_letters_mode"
        android:entries="@array/pref_phonetic_letters_mode_entries"
        android:entryValues="@array/pref_phonetic_letters_mode_values"
        android:key="@string/pref_phonetic_letters_mode_key"
        android:summary="%s"
        android:title="@string/title_pref_phonetic_letters_mode" />
    <ListPreference
        android:defaultValue="@string/pref_capital_letters_default"
        android:entries="@array/pref_capital_letters_entries"
        android:entryValues="@array/pref_capital_letters_values"
        android:key="@string/pref_capital_letters_key"
        android:summary="%s"
        android:title="@string/title_pref_capital_letters" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_formatting_inline_default"
        android:key="@string/pref_formatting_inline_key"
        android:summary="@string/summary_text_formatting_verbosity"
        android:title="@string/title_text_formatting_inline" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:key="@string/pref_formatting_inline_detail_key"
        android:dependency="@string/pref_formatting_inline_key"
        android:title="@string/title_text_formatting_verbosity_options"
        android:fragment="com.google.android.accessibility.talkback.preference.base.TextFormattingDetailFragment" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_punctuation_default"
        android:key="@string/pref_punctuation_key"
        android:visibility="invisible"
        android:title="@string/title_pref_punctuation" />
    <com.google.android.accessibility.talkback.preference.base.PunctuationListPreference
        android:defaultValue="@string/pref_punctuation_verbosity_default"
        android:entries="@array/pref_punctuation_entries"
        android:entryValues="@array/pref_punctuation_values"
        android:key="@string/pref_punctuation_verbosity"
        android:summary="%s"
        android:title="@string/title_pref_punctuation" />
    <ListPreference
        android:defaultValue="@string/pref_emoji_speech_default"
        android:entries="@array/pref_emoji_speech_entries"
        android:entryValues="@array/pref_emoji_speech_values"
        android:key="@string/pref_emoji_speech_key"
        android:summary="%s"
        android:title="@string/title_pref_emoji_speech" />
    <ListPreference
        android:defaultValue="@string/pref_emoji_repeat_count_default"
        android:entries="@array/pref_emoji_repeat_count_entries"
        android:entryValues="@array/pref_emoji_repeat_count_values"
        android:key="@string/pref_emoji_repeat_count_key"
        android:summary="%s"
        android:title="@string/title_pref_emoji_repeat_count" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_count_repeated_symbols_default"
        android:key="@string/pref_count_repeated_symbols_key"
        android:summary="@string/summary_pref_count_repeated_symbols"
        android:title="@string/title_pref_count_repeated_symbols" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
</PreferenceScreen>
