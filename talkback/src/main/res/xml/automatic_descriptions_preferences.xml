<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:key="@string/pref_category_automatic_description_summary_key"
      android:summary="@string/title_pref_category_automatic_description_summary"
      android:selectable="false" />

  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="@bool/pref_detailed_image_description_default"
      android:key="@string/pref_detailed_image_description_key"
      android:title="@string/title_pref_detailed_image_description" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="@bool/pref_ai_label_suggestion_default"
      android:key="@string/pref_ai_label_suggestion_key"
      android:summary="@string/summary_pref_ai_label_suggestion"
      android:title="@string/title_pref_ai_label_suggestion" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:key="@string/pref_image_description_key"
      android:title="@string/title_pref_image_description" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:key="@string/pref_icon_detection_key"
      android:title="@string/title_pref_icon_detection" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:key="@string/pref_text_recognition_key"
      android:title="@string/title_pref_text_recognition" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference
      android:defaultValue="@string/pref_ocr_engine_default"
      android:dialogTitle="@string/title_pref_ocr_engine"
      android:entries="@array/pref_ocr_engine_entries"
      android:entryValues="@array/pref_ocr_engine_values"
      android:key="@string/pref_ocr_engine_key"
      android:summary="%s"
      android:title="@string/title_pref_ocr_engine" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:key="@string/pref_ocr_data_download_key"
      android:title="@string/title_pref_ocr_data_download" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory
      android:key="pref_ai_services"
      android:title="@string/title_pref_category_ai_services">
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:key="pref_ai_provider_choice"
        android:title="@string/title_pref_ai_provider" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
</PreferenceScreen>
