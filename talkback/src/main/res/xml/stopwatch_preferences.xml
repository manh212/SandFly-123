<?xml version="1.0" encoding="utf-8"?>
<!-- Stopwatch. Holding volume up at the lock screen starts or stops it, as the volume key
     settings say. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="true"
      android:key="pref_stopwatch_sound"
      android:title="@string/stopwatch_sound_title" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="true"
      android:key="pref_stopwatch_vibration"
      android:title="@string/stopwatch_vibration_title" />
  <ListPreference
      android:defaultValue="10"
      android:key="pref_stopwatch_interval_minutes"
      android:summary="%s"
      android:title="@string/stopwatch_interval_title" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:fragment="com.google.android.accessibility.talkback.timer.StopwatchHistoryFragment"
      android:key="pref_stopwatch_history_screen"
      android:title="@string/stopwatch_history_title" />
</PreferenceScreen>
