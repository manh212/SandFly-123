<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="true"
      android:key="pref_call_announce"
      android:title="@string/call_announce_title" />
  <ListPreference
      android:defaultValue="0"
      android:dependency="pref_call_announce"
      android:key="pref_call_repeats"
      android:summary="%s"
      android:title="@string/call_repeats_title" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="false"
      android:key="pref_call_duration"
      android:title="@string/call_duration_title" />
  <ListPreference
      android:defaultValue="0"
      android:key="pref_call_duration_interval"
      android:summary="%s"
      android:title="@string/call_interval_title" />
  <ListPreference
      android:defaultValue=""
      android:key="pref_call_voice_profile"
      android:summary="%s"
      android:title="@string/call_voice_title" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="false"
      android:key="pref_call_during_dnd"
      android:title="@string/call_dnd_title" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="false"
      android:key="pref_call_quiet_hours"
      android:title="@string/call_quiet_title" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:dependency="pref_call_quiet_hours"
      android:key="pref_call_quiet_start"
      android:title="@string/call_quiet_start_title" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:dependency="pref_call_quiet_hours"
      android:key="pref_call_quiet_end"
      android:title="@string/call_quiet_end_title" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory
      android:key="pref_call_limit_category"
      android:title="@string/call_limit_category">
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="false"
        android:key="pref_call_limit_enabled"
        android:title="@string/call_limit_enabled_title" />
    <EditTextPreference
        android:defaultValue="10"
        android:dialogTitle="@string/call_limit_minutes_title"
        android:key="pref_call_limit_minutes"
        android:title="@string/call_limit_minutes_title" />
    <ListPreference
        android:defaultValue="OUTGOING"
        android:entries="@array/call_limit_scope_entries"
        android:entryValues="@array/call_limit_scope_values"
        android:key="pref_call_limit_scope"
        android:summary="%s"
        android:title="@string/call_limit_scope_title" />
    <com.google.android.accessibility.talkback.preference.base.AccessibilityFooterPreference
        android:key="pref_call_limit_notice"
        android:selectable="false"
        android:title="@string/call_limit_legacy_notice" />
    <com.google.android.accessibility.talkback.preference.base.AccessibilityFooterPreference
        android:key="pref_call_limit_behavior"
        android:selectable="false"
        android:title="@string/call_limit_behavior_notice" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:fragment="com.google.android.accessibility.talkback.notifications.InitialSetupFragment"
      android:key="pref_call_permissions"
      android:title="@string/call_permissions_title" />
</PreferenceScreen>
