        ".write": "((auth != null && root.child('admins').child(auth.uid).val() === true) && !newData.exists()) || (auth != null && !root.child('forumBans').child(auth.uid).exists() && !data.exists() && newData.exists() && newData.child(\"uid\").val() === auth.uid && newData.child(\"locked\").val() === false && !root.child(\"forumTopics\").child($topic).exists())",
        ".validate": "$topic.matches(/^[0-9]{13}-[0-9a-f]{20}$/) && newData.hasChildren([\"uid\",\"name\",\"category\",\"title\",\"body\",\"locked\",\"createdAt\"])",
        "uid": {
          ".validate": "newData.val() === auth.uid"
        },
