          ".validate": "newData.isString() && newData.val() === root.child('forumProfiles').child(auth.uid).child('name').val()"
        },
        "category": {
          ".validate": "(newData.val() === 'general' || newData.val() === 'questions' || newData.val() === 'lua' || newData.val() === 'ideas' || newData.val() === 'guides')"
        },
        "title": {
          ".validate": "newData.isString() && newData.val().length >= 4 && newData.val().length <= 140"
        },
        "body": {
          ".validate": "newData.isString() && newData.val().length >= 5 && newData.val().length <= 5000"
        },
        "locked": {
          ".write": "(auth != null && root.child('admins').child(auth.uid).val() === true) && data.exists() && newData.isBoolean()",
          ".validate": "newData.isBoolean()"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "forumPosts": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "(auth != null && root.child('admins').child(auth.uid).val() === true) && !newData.exists()",
      "$topic": {
        ".read": "auth != null && ((auth != null && root.child('admins').child(auth.uid).val() === true) || (query.orderByKey && query.limitToLast <= 50))",
        ".write": "(auth != null && root.child('admins').child(auth.uid).val() === true) && !newData.exists()",
        "$post": {
          ".read": "auth != null",
          ".write": "((auth != null && root.child('admins').child(auth.uid).val() === true) && !newData.exists()) || (auth != null && !root.child('forumBans').child(auth.uid).exists() && $topic.matches(/^[0-9]{13}-[0-9a-f]{20}$/) && !data.exists() && newData.exists() && root.child(\"forumTopics\").child($topic).exists() && root.child(\"forumTopics\").child($topic).child(\"locked\").val() === false && newData.child(\"uid\").val() === auth.uid)",
          ".validate": "$post.matches(/^[0-9]{13}-[0-9a-f]{20}$/) && newData.hasChildren([\"uid\",\"name\",\"text\",\"parent\",\"mention\",\"createdAt\"])",
          "uid": {
            ".validate": "newData.val() === auth.uid"
          },
          "name": {
            ".validate": "newData.isString() && newData.val() === root.child('forumProfiles').child(auth.uid).child('name').val()"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 3000"
          },
          "parent": {
            ".validate": "newData.isString() && (newData.val() === \"\" || (newData.val().matches(/^[0-9]{13}-[0-9a-f]{20}$/) && root.child(\"forumPosts\").child($topic).child(newData.val()).exists()))"
          },
          "mention": {
            ".validate": "newData.isString() && (newData.val() === \"\" || (newData.val() !== auth.uid && root.child(\"forumProfiles\").child(newData.val()).exists()))"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "forumProfiles": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "(auth != null && root.child('admins').child(auth.uid).val() === true) && !newData.exists()",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid && newData.exists()",
        ".validate": "newData.hasChildren([\"name\"])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 60"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "forumNotices": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "(auth != null && root.child('admins').child(auth.uid).val() === true) && !newData.exists()",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && query.orderByChild === 'lastAt' && query.limitToLast <= 40",
        ".indexOn": [
          "lastAt"
        ],
        ".write": "(auth != null && root.child('admins').child(auth.uid).val() === true) && !newData.exists()",
        "$notice": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "(auth != null && root.child('admins').child(auth.uid).val() === true && !newData.exists()) || (auth != null && !root.child('forumBans').child(auth.uid).exists() && !data.exists() && newData.exists() && auth.uid !== $uid && root.child(\"forumPosts\").child(newData.child(\"topic\").val()).child(newData.child(\"post\").val()).child(\"uid\").val() === auth.uid && ((newData.child(\"kind\").val() === \"mention\" && root.child(\"forumPosts\").child(newData.child(\"topic\").val()).child(newData.child(\"post\").val()).child(\"mention\").val() === $uid) || (newData.child(\"kind\").val() === \"reply\" && ((root.child(\"forumPosts\").child(newData.child(\"topic\").val()).child(newData.child(\"post\").val()).child(\"parent\").val() === \"\" && root.child(\"forumTopics\").child(newData.child(\"topic\").val()).child(\"uid\").val() === $uid) || (root.child(\"forumPosts\").child(newData.child(\"topic\").val()).child(newData.child(\"post\").val()).child(\"parent\").val() !== \"\" && root.child(\"forumPosts\").child(newData.child(\"topic\").val()).child(root.child(\"forumPosts\").child(newData.child(\"topic\").val()).child(newData.child(\"post\").val()).child(\"parent\").val()).child(\"uid\").val() === $uid)))))",
          ".validate": "newData.hasChildren([\"topic\",\"post\",\"from\",\"kind\",\"lastAt\"]) && $notice === newData.child(\"topic\").val() + \"_\" + newData.child(\"post\").val()",
          "topic": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{13}-[0-9a-f]{20}$/)"
          },
          "post": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{13}-[0-9a-f]{20}$/)"
          },
          "from": {
            ".validate": "newData.val() === auth.uid"
          },
