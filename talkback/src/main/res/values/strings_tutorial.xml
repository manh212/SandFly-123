    <string name="sandfly_tutorial_title">Hướng dẫn SandFly</string>
    <string name="sandfly_tutorial_lesson_heading"><xliff:g id="lesson" example="Moving between items">%1$s</xliff:g>, bài <xliff:g id="number" example="3">%2$d</xliff:g> trong <xliff:g id="count" example="17">%3$d</xliff:g></string>
    <string name="sandfly_tutorial_step">Bước <xliff:g id="number" example="1">%1$d</xliff:g> trong <xliff:g id="count" example="2">%2$d</xliff:g>: <xliff:g id="instruction" example="Swipe right to move to the next item.">%3$s</xliff:g></string>
    <string name="sandfly_tutorial_progress"><xliff:g id="done" example="2">%1$d</xliff:g> trong <xliff:g id="count" example="4">%2$d</xliff:g>.</string>
    <string name="sandfly_tutorial_lesson_complete">Đã hoàn thành bài học.</string>
    <string name="sandfly_tutorial_lesson_complete_next">Đã hoàn thành bài học. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> để bắt đầu bài tiếp theo.</string>
    <string name="sandfly_tutorial_lesson_complete_last">Đã hoàn thành bài học. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> để kết thúc hướng dẫn.</string>
    <string name="sandfly_tutorial_no_gesture"><xliff:g id="action" example="Next item">%1$s</xliff:g> chưa được gán cử chỉ. Hãy gán trong cài đặt Cử chỉ hoặc chọn Bỏ qua bước.</string>
    <string name="sandfly_tutorial_back_in_lesson">Thao tác Quay lại không thoát khỏi bài học. Để chọn bài khác, hãy mở Mục lục.</string>
    <string name="sandfly_tutorial_not_in_lesson">Không thực hiện <xliff:g id="action" example="Home">%1$s</xliff:g> trong bài học. Để thoát hướng dẫn, chọn Đóng hướng dẫn trong Mục lục.</string>
    <string name="sandfly_tutorial_not_in_lesson_short">Không thực hiện <xliff:g id="action" example="Turn speech on or off">%1$s</xliff:g> trong bài học.</string>
