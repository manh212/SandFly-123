  <!-- For text editing pages in tutorial. -->
  <!-- The title of using text boxes page. [CHAR_LIMIT=NONE]-->
  <string name="using_text_boxes_title">Using text boxes</string>
  <!-- The description about how to use text boxes. [CHAR_LIMIT=NONE]-->
  <string name="using_text_boxes_text">When you\'re in a text box, a keyboard will open up at the bottom of your screen.\n\nTo dismiss the keyboard, double-tap the back button in the bottom corner of your screen.\n\nTry activating and dismissing the text box below.</string>
  <!-- The hint of edit box. [CHAR_LIMIT=NONE]-->
  <string name="edit_box_hint">This is a text box</string>
  <!-- A hint to notify user can type here. [CHAR_LIMIT=NONE]-->
  <string name="enter_text_here">Enter text here</string>
  <!-- The title of typing text page. [CHAR_LIMIT=NONE]-->
  <string name="typing_text_title">Typing text</string>
  <!-- The description about how to type text. [CHAR_LIMIT=NONE]-->
  <string name="basic_typing_text_text">When you\'re in a text box, a keyboard will open up at the bottom of your screen.</string>
  <!-- The description about how to type text. [CHAR_LIMIT=NONE]-->
  <string name="typing_text_text">Move your finger across the keyboard. When you hear the letter you want to type, lift your finger.\n\nTry activating the text box below and type your name.</string>
  <!-- The sub title of other ways to type in typing text page. [CHAR_LIMIT=NONE]-->
  <string name="other_ways_to_type_title">Other ways to type</string>
  <!-- The description of other ways to type in typing text page. [CHAR_LIMIT=NONE]-->
  <string name="other_ways_to_type_text">There are other ways to type in Meridian. For example, you can use double tap to enter a letter, or Direct key input, where you slide across the keys and lift your finger to type the key you stop on. You can also enter text by dictating it.</string>
  <!-- The description of other ways to type in typing text page. [CHAR_LIMIT=NONE]-->
  <string name="basic_other_ways_to_type_text">There are other ways to type in Meridian. For example, you can use double tap to enter a letter, or Direct key input, where you slide across the keys and lift your finger to type the key you stop on. You can change this later in Meridian settings > On-screen keyboard > Typing method.</string>
  <!-- Source: The text of introducing TalkBack for TTS span. [CHAR_LIMIT=NONE] [BACKUP_MESSAGE_ID: 380750154623317254]-->
  <string name="basic_other_ways_to_type_text_tts">There are other ways to type in Meridian. For example, you can use double tap to enter a letter, or Direct key input, where you slide across the keys and lift your finger to type the key you stop on. You can change this later in Meridian settings then On-screen keyboard then Typing method.</string>
  <!-- The text of change typing preference button in typing text page. [CHAR_LIMIT=NONE]-->
  <string name="change_typing_preference_text">Change typing preference</string>
  <!-- The title of moving cursor page. [CHAR_LIMIT=NONE]-->
  <string name="moving_cursor_title">Moving the cursor</string>
  <!-- The description about how to move cursor. [CHAR_LIMIT=NONE]-->
  <string name="moving_cursor_text">When you have activated a text box, you can move the cursor between letters by swiping up or down.\n\nTry it in the text box below.</string>
  <!-- The text in edit box to try some editing actions, like copy and paste. [CHAR_LIMIT=NONE]-->
  <string name="edit_box_text">Welcome to Meridian</string>
  <!-- The title of selecting text from edit box. [CHAR_LIMIT=NONE]-->
  <string name="selecting_text_title">Selecting text</string>
  <!-- The description about how to select the text via gesture. [CHAR_LIMIT=NONE]-->
  <string name="selecting_text_text">In a text box, move the cursor to the beginning of the text you want to select.\n\nStart selection mode with the Start selection mode action. It is in the text box\'s context menu, and you can also assign it to a gesture in Meridian settings > Gestures. Then move the cursor to the end of the text to select it. Use the same action again to end selection mode.\n\nTry to select the word \"Welcome\" in the text box below.</string>
  <!-- The description about how to select the text via gesture. [CHAR_LIMIT=NONE]-->
  <string name="selecting_text_text_pre_r">In a text box, move the cursor to the beginning of the text you want to select.\n\nSwipe down and then right to open the Meridian menu. Double-tap actions and then start selection mode. Move the cursor to the end of the text.\n\nOpen the Meridian menu again, then double-tap actions to end selection mode.\n\nTry to select the word \"Welcome\" in the text box below.</string>
  <!-- The title of coping, cutting and pasting text. [CHAR_LIMIT=NONE]-->
  <string name="copy_cut_paste_title">Copy, cut, and paste</string>
  <!-- The description about how to copy text. [CHAR_LIMIT=NONE]-->
  <string name="copy_text">After selecting text, copy it with the Copy action in the text box\'s context menu, or with a gesture you assign to Copy in Meridian settings > Gestures. Copy has no gesture by default. Double-tapping with 3 fingers turns voice feedback on or off instead.\n\nTry to copy a word in the text box below.</string>
  <!-- The description about how to cut or paste text. [CHAR_LIMIT=NONE]-->
  <string name="cut_paste_text">To cut text, double-tap and hold with 3 fingers.\n\nTo paste text, triple-tap and hold with 3 fingers. Triple-tapping with 3 fingers without holding copies the last spoken phrase instead.\n\nTry to paste a word in the text box below.</string>
  <!-- The description about how to copy text. [CHAR_LIMIT=NONE]-->
  <string name="copy_text_pre_r">After selecting text, you can copy it in the Meridian menu. Swipe down and then right to open the Meridian menu. Double-tap actions and then copy.\n\nTry to copy a word in the text box below.</string>
  <!-- The description about how to cut or paste text. [CHAR_LIMIT=NONE]-->
  <string name="cut_paste_text_pre_r">To cut or paste text, open the Meridian menu and double-tap actions.\n\nTry to paste a word in the text box below.</string>
  <!-- The text in edit box to give a hint to the user. [CHAR_LIMIT=140]-->
  <string name="edit_box_hint_paste_text">Paste text here</string>
  <!-- The title of typo correction tutorial text. [CHAR_LIMIT=NONE]-->
  <string name="typo_correction_title">Proofreading</string>
  <!-- The content of typo correction tutorial text. [CHAR_LIMIT=NONE]-->
  <string name="typo_correction_text">You can use proofreading to check the spelling or grammar within a text box.\n\nTo try it, focus on the text box below, which contains spelling errors. Then, swipe right with 3 fingers until you find \"Proofread\".</string>
  <!-- The content of typo correction tutorial text for pre R. [CHAR_LIMIT=NONE]-->
  <string name="typo_correction_text_pre_r">You can use proofreading to check the spelling or grammar within a text box.\n\nTo try it, focus on the text box below, which contains spelling errors. After focusing, swipe down and then up until you find \"Proofread\".</string>
  <!-- The content of typo correction tutorial text for supported locale but none English. [CHAR_LIMIT=NONE]-->
  <string name="typo_correction_text_supported_but_not_english">You can use proofreading to check the spelling or grammar within a text box.\n\nTo try it, focus on the text box below and type a misspelled word. Then, swipe right with 3 fingers until you find \"Proofread\".</string>
  <!-- The content of typo correction tutorial text for supported locale but none English for pre R. [CHAR_LIMIT=NONE]-->
  <string name="typo_correction_text_supported_but_not_english_pre_r">You can use proofreading to check the spelling or grammar within a text box.\n\nTo try it, focus on the text box below and type a misspelled word. After focusing, swipe down and then up until you find \"Proofread\".</string>
  <!-- The content of typo correction edit box typos example. [CHAR_LIMIT=NONE]-->
  <string name="typo_correction_typo_example" translatable="false">Wellcome too Meridian.</string>
  <!-- The content of typo correction edit box hint. [CHAR_LIMIT=NONE]-->
  <string name="typo_correction_editbox_hint">Type here</string>

  <!-- For reading navigation pages in tutorial. -->
  <!-- The title of reading by character, word or paragraph page. [CHAR_LIMIT=NONE]-->
  <string name="read_by_character_title">Read by character, word, or paragraph</string>
  <!-- The description about how to read by character. [CHAR_LIMIT=NONE]-->
  <string name="read_by_character_text">Sometimes, you might want to hear text read aloud one character at a time.\n\nTo do this, swipe right with 3 fingers until you hear \"<xliff:g example="characters">%1$s</xliff:g>\". Next, swipe up to move the navigation focus backward by character. Swipe down to move the navigation focus forward by character.\n\nTry it now. When you swipe right with 3 fingers, you can also choose to read by words or paragraphs.</string>
  <!-- The description about how to read by character. [CHAR_LIMIT=NONE]-->
  <string name="read_by_character_text_pre_r">Sometimes, you might want to hear text read aloud one character at a time.\n\nTo do this, swipe down and then up until you hear \"<xliff:g example="characters">%1$s</xliff:g>\". Next, swipe up to move the navigation focus backward by character. Swipe down to move the navigation focus forward by character.\n\nTry it now. When you swipe down and then up, you can also choose to read by words or paragraphs.</string>
  <!-- The title of jump between controls page. [CHAR_LIMIT=NONE]-->
  <string name="jump_between_controls_title">Jump between controls</string>
  <!-- The description about how to move focus between some specific widgets. [CHAR_LIMIT=NONE]-->
  <string name="jump_between_controls_text">Controls are items that you can interact with, like buttons, checkboxes, and text boxes.\n\nOn some pages, you may want to jump between controls to quickly find an action, like the next button.\n\nTo do this, swipe right with 3 fingers until you hear \"<xliff:g example="controls">%1$s</xliff:g>\". Next, swipe up to go to the previous control on a page. Swipe down to go to the next control on a page.\n\nTry it now. Switch to controls and find the next button.</string>
  <!-- The description about how to move focus between some specific widgets. [CHAR_LIMIT=NONE]-->
  <string name="jump_between_controls_text_pre_r">Controls are items that you can interact with, like buttons, checkboxes, and text boxes.\n\nOn some pages, you may want to jump between controls to quickly find an action, like the next button.\n\nTo do this, swipe down and then up until you hear \"<xliff:g example="controls">%1$s</xliff:g>\". Next, swipe up to go to the previous control on a page. Swipe down to go to the next control on a page.\n\nTry it now. Switch to controls and find the next button.</string>
  <!-- The title of jump between links page. [CHAR_LIMIT=NONE]-->
  <string name="jump_between_links_title">Jump between links</string>
  <!--
  Source: The description about how to move focus between links.
  Description: The translation of "Link 5" should be the same as link5_text. In RTL language, "Swipe right to find the next button" should be translated to "Swipe left to find the next button". [CHAR_LIMIT=NONE]
  -->
  <string name="jump_between_links_text">You can also jump between links on a page.\n\nTo try it now, swipe right with 3 fingers until you hear \"<xliff:g example="links">%1$s</xliff:g>\". Next, swipe down to find the link named \"Link 5\". While in the tutorial, double tapping this link will not do anything.\n\nSwipe right to find the next button and go to the next page.</string>
  <!--
  Source: The description about how to move focus between links.
  Description: The translation of "Link 5" should be the same as link5_text. In RTL language, "right" and "left" should be translated reverse. [CHAR_LIMIT=NONE]
  -->
  <string name="jump_between_links_text_pre_r">You can also jump between links on a page.\n\nTo try it now, swipe down and then up until you hear \"<xliff:g example="links">%1$s</xliff:g>\". Next, swipe down and find the link named \"Link 5\". While in the tutorial, double tapping this link will not do anything.\n\nSwipe right to find the next button and go to the next page.</string>
