<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory android:key="@string/pref_category_group_menu_controls_key">
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.preference.base.ContextMenuFragment"
        android:key="@string/pref_category_manage_context_menu_key"
        android:title="@string/title_pref_category_context_menu" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.preference.base.SelectorMenuFragment"
        android:key="@string/pref_category_manage_selector_menu_key"
        android:title="@string/title_pref_category_selector_menu" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:key="@string/pref_show_context_menu_granularity_detail_setting_key"
        android:title="@string/title_pref_category_navigation_menu"
        android:fragment="com.google.android.accessibility.talkback.preference.base.NavigationMenuFragment" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_quick_settings_default"
        android:key="@string/pref_quick_settings_key"
        android:title="@string/title_pref_quick_settings" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.preference.base.CustomMenusFragment"
        android:key="pref_custom_menus_screen"
        android:title="@string/custom_menus_title" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.quicksettings.QuickSettingsItemsFragment"
        android:key="@string/pref_quick_settings_items_key"
        android:title="@string/title_pref_quick_settings_items" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
</PreferenceScreen>
