    <string name="sandfly_tutorial_welcome_title">Chào mừng</string>
    <string name="sandfly_tutorial_welcome_intro">Hướng dẫn này giúp bạn học các cử chỉ của SandFly. Mỗi bài đưa ra yêu cầu, chờ bạn thực hiện cử chỉ rồi chuyển sang bước tiếp theo. Yêu cầu là mục đầu tiên sau tên bài. Mục lục liệt kê các bài và hướng dẫn sẽ mở lại tại bài bạn đang học.</string>
    <string name="sandfly_tutorial_welcome_start"><xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> ở bất kỳ đâu trên màn hình để bắt đầu.</string>
    <string name="sandfly_tutorial_explore_title">Khám phá bằng cảm ứng</string>
    <string name="sandfly_tutorial_explore_intro">Chạm vào màn hình để nghe tên mục dưới ngón tay. Chạm vào mục chưa kích hoạt mục đó.</string>
    <string name="sandfly_tutorial_explore_find">Di chuyển một ngón tay trên màn hình và tìm bốn ô: Mặt trời, Mặt trăng, Ngôi sao và Đám mây.</string>
    <string name="sandfly_tutorial_explore_activate">Chạm vào Ngôi sao rồi nhấc ngón tay. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> ở bất kỳ đâu để kích hoạt.</string>
    <string name="sandfly_tutorial_tile_sun">Mặt trời</string>
    <string name="sandfly_tutorial_tile_moon">Mặt trăng</string>
    <string name="sandfly_tutorial_tile_star">Ngôi sao</string>
    <string name="sandfly_tutorial_tile_cloud">Đám mây</string>
    <string name="sandfly_tutorial_move_title">Chuyển giữa các mục</string>
    <string name="sandfly_tutorial_move_intro">Vuốt để chuyển đến mục tiếp theo hoặc trước đó theo thứ tự đọc trên màn hình.</string>
    <string name="sandfly_tutorial_move_next"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> để chuyển đến mục tiếp theo. Tiếp tục đến khi gặp <xliff:g id="item" example="Eggs">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_move_previous"><xliff:g id="gesture" example="Swipe left">%1$s</xliff:g> để chuyển về mục trước đó. Quay lại <xliff:g id="item" example="Bread">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_item_apples">Táo</string>
    <string name="sandfly_tutorial_item_bread">Bánh mì</string>
    <string name="sandfly_tutorial_item_cheese">Phô mai</string>
    <string name="sandfly_tutorial_item_dates">Chà là</string>
    <string name="sandfly_tutorial_item_eggs">Trứng</string>
    <string name="sandfly_tutorial_activate_title">Kích hoạt mục</string>
    <string name="sandfly_tutorial_activate_intro">Kích hoạt mục đang được lấy nét, bất kể bạn chạm vào vị trí nào trên màn hình.</string>
    <string name="sandfly_tutorial_activate_button">Chuyển đến <xliff:g id="button" example="Ring the bell">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> để kích hoạt.</string>
    <string name="sandfly_tutorial_activate_check_box">Đánh dấu <xliff:g id="check_box" example="Extra cheese">%1$s</xliff:g> bằng cách tương tự.</string>
    <string name="sandfly_tutorial_activate_hold">Một số mục có thao tác khác khi nhấn giữ. Chuyển đến <xliff:g id="button" example="Details">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap and hold">%1$s</xliff:g> để nhấn giữ.</string>
    <string name="sandfly_tutorial_bell">Rung chuông</string>
    <string name="sandfly_tutorial_bell_rung">Số lần rung chuông: <xliff:g id="count" example="1">%1$d</xliff:g></string>
    <string name="sandfly_tutorial_extra_cheese">Thêm phô mai</string>
    <string name="sandfly_tutorial_details">Chi tiết</string>
    <string name="sandfly_tutorial_details_shown">Bàn cho hai người lúc 7 giờ tối, cạnh cửa sổ.</string>
    <string name="sandfly_tutorial_pause_title">Tạm dừng giọng đọc</string>
    <string name="sandfly_tutorial_pause_intro">Bạn có thể tạm dừng giọng đọc giữa một mục và tiếp tục từ vị trí đang dừng.</string>
    <string name="sandfly_tutorial_pause_pause">Chuyển đến câu chuyện bên dưới. Khi đang đọc, <xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> để tạm dừng rồi làm lại để tiếp tục.</string>
    <string name="sandfly_tutorial_pause_resume"><xliff:g id="gesture" example="Tap with 2 fingers">%1$s</xliff:g> một lần nữa để tiếp tục đọc.</string>
    <string name="sandfly_tutorial_story">Ruồi cát là loài ruồi nhỏ sống ở bãi biển, ven sông và trong rừng. Chúng hoạt động mạnh nhất lúc bình minh và hoàng hôn, khi trời lặng gió. Chỉ con cái đốt người vì cần máu để sinh trứng. Vết đốt có thể ngứa nhiều ngày, vì vậy người đến nơi có ruồi cát thường mang thuốc chống côn trùng. Ruồi cát bay yếu và ngay cả gió nhẹ cũng khiến chúng tránh xa.</string>
    <string name="sandfly_tutorial_reading_controls_title">Điều khiển đọc</string>
    <string name="sandfly_tutorial_reading_controls_intro">Điều khiển đọc quy định tác dụng của thao tác vuốt lên và xuống, chẳng hạn chuyển theo từ, ký tự hoặc thay đổi tốc độ nói. Vuốt phải và trái vẫn chuyển giữa các mục.</string>
    <string name="sandfly_tutorial_reading_controls_move">Chuyển đến câu bên dưới.</string>
    <string name="sandfly_tutorial_choose_reading_control"><xliff:g id="gesture" example="Swipe down then up">%1$s</xliff:g> hoặc <xliff:g id="gesture" example="Swipe up then down">%2$s</xliff:g> để đổi điều khiển đọc. Chọn <xliff:g id="reading_control" example="Words">%3$s</xliff:g>.</string>
    <string name="sandfly_tutorial_reading_controls_next_word"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> để chuyển sang từ tiếp theo. Hãy chuyển ba từ.</string>
    <string name="sandfly_tutorial_reading_controls_characters">Đổi điều khiển đọc thành <xliff:g id="reading_control" example="Characters">%2$s</xliff:g>. <xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> để chuyển từng ký tự.</string>
    <string name="sandfly_tutorial_sentence">Con cáo nâu nhanh nhẹn nhảy qua con chó lười.</string>
    <string name="sandfly_tutorial_headings_title">Tiêu đề</string>
    <string name="sandfly_tutorial_headings_intro">Màn hình và trang web chia nội dung bằng các tiêu đề. Điều khiển đọc Tiêu đề chuyển từ tiêu đề này sang tiêu đề khác.</string>
    <string name="sandfly_tutorial_headings_jump"><xliff:g id="gesture" example="Swipe down">%1$s</xliff:g> để chuyển đến tiêu đề tiếp theo. Hãy chuyển đến <xliff:g id="heading" example="Weekend">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_forecast_today">Hôm nay</string>
    <string name="sandfly_tutorial_forecast_today_text">Trời nắng ấm, gió nhẹ.</string>
    <string name="sandfly_tutorial_forecast_tomorrow">Ngày mai</string>
    <string name="sandfly_tutorial_forecast_tomorrow_text">Buổi sáng nhiều mây, có mưa từ giữa trưa.</string>
    <string name="sandfly_tutorial_forecast_weekend">Cuối tuần</string>
    <string name="sandfly_tutorial_forecast_weekend_text">Thứ Bảy có gió, Chủ nhật trời quang.</string>
    <string name="sandfly_tutorial_continuous_title">Đọc liên tục</string>
    <string name="sandfly_tutorial_continuous_intro">SandFly có thể đọc từ mục đang được lấy nét đến cuối màn hình mà không cần vuốt. Chạm vào màn hình để dừng đọc.</string>
    <string name="sandfly_tutorial_continuous_move">Chuyển đến dòng đầu tiên của công thức.</string>
    <string name="sandfly_tutorial_continuous_read"><xliff:g id="gesture" example="Swipe down then right">%1$s</xliff:g> để đọc từ mục đang được lấy nét.</string>
    <string name="sandfly_tutorial_continuous_read_from_menu"><xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g> để mở trình đơn SandFly rồi chọn <xliff:g id="command" example="Read from focused item">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_recipe_1">Bánh kếp: trộn bột mì, trứng và sữa thành hỗn hợp mịn.</string>
    <string name="sandfly_tutorial_recipe_2">Đun nóng một ít bơ trong chảo.</string>
    <string name="sandfly_tutorial_recipe_3">Đổ một lớp bột mỏng phủ mặt chảo.</string>
    <string name="sandfly_tutorial_recipe_4">Lật bánh khi mặt dưới đã vàng.</string>
    <string name="sandfly_tutorial_recipe_5">Ăn cùng chanh và đường.</string>
    <string name="sandfly_tutorial_scrolling_title">Cuộn danh sách</string>
    <string name="sandfly_tutorial_scrolling_intro">Danh sách chỉ hiển thị một phần mục tại mỗi thời điểm. Vuốt qua mục cuối đang hiển thị để cuộn danh sách.</string>
    <string name="sandfly_tutorial_scrolling_swipe"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g> qua danh sách cho đến khi gặp <xliff:g id="item" example="Item 15">%2$s</xliff:g>.</string>
    <string name="sandfly_tutorial_scrolling_page"><xliff:g id="gesture" example="Swipe right then left">%1$s</xliff:g> để cuộn tiến một trang.</string>
    <string name="sandfly_tutorial_list_item">Mục <xliff:g id="number" example="15">%1$d</xliff:g></string>
    <string name="sandfly_tutorial_sliders_title">Thanh trượt</string>
    <string name="sandfly_tutorial_sliders_intro">Khi thanh trượt đang được lấy nét, vuốt lên hoặc xuống để thay đổi giá trị.</string>
    <string name="sandfly_tutorial_sliders_change">Chuyển đến thanh trượt <xliff:g id="slider" example="Brightness">%3$s</xliff:g>. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> hoặc <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> để thay đổi giá trị.</string>
    <string name="sandfly_tutorial_sliders_highest">Đặt <xliff:g id="slider" example="Brightness">%1$s</xliff:g> thành 100 phần trăm, giá trị cao nhất.</string>
    <string name="sandfly_tutorial_brightness">Độ sáng</string>
    <string name="sandfly_tutorial_actions_title">Tác vụ</string>
    <string name="sandfly_tutorial_actions_intro">Một số mục có tác vụ khác ngoài kích hoạt, như Lưu trữ hoặc Xóa tin nhắn. Khi mục được lấy nét, điều khiển đọc Tác vụ sẽ lần lượt duyệt các tác vụ đó.</string>
    <string name="sandfly_tutorial_actions_archive">Chuyển đến tin nhắn. <xliff:g id="gesture" example="Swipe up">%1$s</xliff:g> hoặc <xliff:g id="gesture" example="Swipe down">%2$s</xliff:g> để duyệt các tác vụ. <xliff:g id="gesture" example="Double-tap">%3$s</xliff:g> để thực hiện tác vụ vừa nghe. Hãy thực hiện <xliff:g id="action" example="Archive">%4$s</xliff:g>.</string>
    <string name="sandfly_tutorial_message">Tin nhắn từ An: Trưa nay ăn cùng nhé?</string>
    <string name="sandfly_tutorial_message_reply">Trả lời</string>
    <string name="sandfly_tutorial_message_archive">Lưu trữ</string>
    <string name="sandfly_tutorial_message_delete">Xóa</string>
    <string name="sandfly_tutorial_typing_title">Nhập văn bản</string>
    <string name="sandfly_tutorial_typing_intro">Kích hoạt ô nhập văn bản để mở bàn phím. Chạm một phím để nghe tên, rồi nhấc ngón tay để nhập.</string>
    <string name="sandfly_tutorial_typing_open">Chuyển đến ô <xliff:g id="field" example="Name">%2$s</xliff:g>. <xliff:g id="gesture" example="Double-tap">%1$s</xliff:g> để bắt đầu nhập.</string>
    <string name="sandfly_tutorial_typing_type">Nhập từ <xliff:g id="word" example="cat">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_typing_delete">Xóa chữ cái cuối cùng bằng phím Xóa trên bàn phím.</string>
    <string name="sandfly_tutorial_name">Tên</string>
    <string name="sandfly_tutorial_typing_word">mèo</string>
    <string name="sandfly_tutorial_system_title">Quay lại, Màn hình chính và thông báo</string>
    <string name="sandfly_tutorial_system_intro">Các cử chỉ này hoạt động trên mọi màn hình. Trong bài học này, hướng dẫn sẽ nói tác dụng thay vì thực hiện thao tác.</string>
    <string name="sandfly_tutorial_system_back"><xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g> để quay lại.</string>
    <string name="sandfly_tutorial_system_home"><xliff:g id="gesture" example="Swipe up then left">%1$s</xliff:g> để về Màn hình chính.</string>
    <string name="sandfly_tutorial_system_overview"><xliff:g id="gesture" example="Swipe left then up">%1$s</xliff:g> để hiển thị ứng dụng gần đây.</string>
    <string name="sandfly_tutorial_system_notifications"><xliff:g id="gesture" example="Swipe right then down">%1$s</xliff:g> để mở thông báo.</string>
    <string name="sandfly_tutorial_menu_title">Trình đơn SandFly</string>
    <string name="sandfly_tutorial_menu_intro">Trình đơn SandFly chứa các lệnh cho mục đang được lấy nét và màn hình hiện tại.</string>
    <string name="sandfly_tutorial_menu_open"><xliff:g id="gesture" example="Tap with 3 fingers">%1$s</xliff:g> để mở trình đơn SandFly. Vuốt qua các lệnh. <xliff:g id="gesture" example="Swipe down then left">%2$s</xliff:g> để đóng trình đơn.</string>
    <string name="sandfly_tutorial_menu_close"><xliff:g id="gesture" example="Swipe down then left">%1$s</xliff:g> để đóng trình đơn.</string>
    <string name="sandfly_tutorial_commands_title">Lệnh hữu ích</string>
    <string name="sandfly_tutorial_commands_intro">Các lệnh này hoạt động trên mọi màn hình.</string>
    <string name="sandfly_tutorial_commands_status"><xliff:g id="gesture" example="Triple-tap with 2 fingers">%1$s</xliff:g> để nghe giờ, mức pin và các thông tin trạng thái khác.</string>
    <string name="sandfly_tutorial_commands_copy"><xliff:g id="gesture" example="Triple-tap with 3 fingers">%1$s</xliff:g> để sao chép nội dung SandFly vừa đọc vào bộ nhớ tạm.</string>
    <string name="sandfly_tutorial_commands_search"><xliff:g id="gesture" example="Swipe left then down">%1$s</xliff:g> để tìm văn bản trên màn hình. Trong bài này, hướng dẫn sẽ nói tác dụng thay vì thực hiện.</string>
    <string name="sandfly_tutorial_commands_speech_off"><xliff:g id="gesture" example="Double-tap with 3 fingers">%1$s</xliff:g> để tắt giọng đọc và làm lại để bật. Trong bài này, hướng dẫn sẽ nói tác dụng thay vì thực hiện.</string>
    <string name="sandfly_tutorial_practice_title">Thực hành cử chỉ</string>
    <string name="sandfly_tutorial_practice_intro">Mỗi cử chỉ sẽ đọc tên và tác dụng thay vì thực hiện. Chuyển đến mục tiếp theo, mục trước và kích hoạt vẫn hoạt động.</string>
    <string name="sandfly_tutorial_practice_step">Thực hiện một cử chỉ bất kỳ để nghe tác dụng. Để dừng, kích hoạt <xliff:g id="button" example="End practice">%1$s</xliff:g>.</string>
    <string name="sandfly_tutorial_practice_gesture"><xliff:g id="gesture" example="Swipe right">%1$s</xliff:g>: <xliff:g id="action" example="Next item">%2$s</xliff:g></string>
    <string name="sandfly_tutorial_end_practice">Kết thúc thực hành</string>
</resources>
