      android:key="@string/pref_settings_group_speech_key"
      android:title="@string/title_pref_reading_content" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:fragment="com.google.android.accessibility.talkback.preference.base.NavigationGroupFragment"
