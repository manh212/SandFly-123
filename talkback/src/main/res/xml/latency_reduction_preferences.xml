<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:key="@string/pref_category_reduce_latency_summary_key"
        android:summary="@string/title_pref_category_reduce_latency_summary"
        android:selectable="false" />

    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:title="@string/reset_latency_settings_title"
        android:key="@string/pref_reset_latency_settings_key"
        app:allowDividerBelow="true"/>

    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_reduce_window_delay_default"
        android:key="@string/pref_reduce_window_delay_key"
        android:summary="@string/pref_reduce_window_delay_summary"
        android:title="@string/pref_reduce_window_delay_title"/>

    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="true"
        android:title="@string/title_pref_low_latency_audio"
        android:summary="@string/summary_pref_low_latency_audio"
        android:key="pref_low_latency_audio" />

    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="false"
        android:title="@string/title_pref_always_interrupt_speech"
        android:summary="@string/summary_pref_always_interrupt_speech"
        android:key="pref_always_interrupt_speech" />

    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_background_order_build_default"
        android:title="@string/title_pref_background_order_build"
        android:summary="@string/summary_pref_background_order_build"
        android:key="@string/pref_background_order_build_key" />

    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_trust_untouched_nodes_default"
        android:title="@string/title_pref_trust_untouched_nodes"
        android:summary="@string/summary_pref_trust_untouched_nodes"
        android:key="@string/pref_trust_untouched_nodes_key" />

    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_keep_prepared_across_unrelated_default"
        android:title="@string/title_pref_keep_prepared_across_unrelated"
        android:summary="@string/summary_pref_keep_prepared_across_unrelated"
        android:key="@string/pref_keep_prepared_across_unrelated_key" />

    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_serve_stale_order_default"
        android:title="@string/title_pref_serve_stale_order"
        android:summary="@string/summary_pref_serve_stale_order"
        android:key="@string/pref_serve_stale_order_key" />

    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_speak_items_before_scroll_default"
        android:title="@string/title_pref_speak_items_before_scroll"
        android:key="@string/pref_speak_items_before_scroll_key" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_cache_keyboard_keys_default"
        android:title="@string/title_pref_cache_keyboard_keys"
        android:summary="@string/summary_cache_keyboard_keys"
        android:key="@string/pref_cache_keyboard_keys" />


    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.preference.base.TypingMethodPrefFragment"
        android:key="@string/pref_typing_confirmation_key"
        app:summary="%s"
        android:title="@string/title_pref_typing_confirmation" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference
        android:defaultValue="@string/pref_typing_long_press_duration_default"
        android:dialogTitle="@string/title_pref_typing_long_tap_duration"
        android:entries="@array/pref_typing_long_press_entries"
        android:entryValues="@array/pref_typing_long_press_values"
        android:key="@string/pref_typing_long_press_duration_key"
        android:summary="%s"
        android:title="@string/title_pref_typing_long_tap_duration" />
</PreferenceScreen>
