  <string name="activated_view">Activated <xliff:g example="button">%1$s</xliff:g></string>
  <!-- Alert dialog title when the user starts the TalkBack tutorial but TalkBack is inactive. [CHAR_LIMIT=60] -->
  <string name="talkback_inactive_title">Meridian is off</string>
  <!-- Alert dialog warning message when the user starts the TalkBack tutorial but TalkBack is inactive. [CHAR_LIMIT=NONE] -->
  <string name="talkback_inactive_warning_message">This tutorial works best with Meridian on. You can make this change in Settings.\n\nIf you continue with Meridian off, some of the tutorial may not work as intended.</string>
  <!-- The checkbox text of the dialog to reject showing the dialog again. [CHAR_LIMIT=60]-->
  <string name="do_not_show_again_check_box">Do not show this again</string>
  <!-- The button when the user starts the TalkBack tutorial but TalkBack is inactive, tap it can keep reviewing talkback tutorial. [CHAR_LIMIT=30] -->
  <string name="talkback_inactive_warning_positive_button">Continue anyways</string>
  <!-- The button when the user starts the TalkBack tutorial but TalkBack is inactive, tap it to go to talkback settings. [CHAR_LIMIT=30] -->
  <string name="talkback_inactive_go_to_settings_button">Go to Settings</string>
  <!-- The alert dialog button when the user starts the TalkBack tutorial section which needs TalkBack to be active during SUW but TalkBack is inactive, tap it to stay in tutorial. [CHAR_LIMIT=30] -->
