  <string name="paragraph1_text">Paragraph 1. </string>
  <!-- The text of paragraph 2. [CHAR_LIMIT=NONE]-->
  <string name="paragraph2_text">Paragraph 2. </string>
  <!-- The text of paragraph 3. [CHAR_LIMIT=NONE]-->
  <string name="paragraph3_text">Paragraph 3. </string>
  <!-- The text of paragraph 4. [CHAR_LIMIT=NONE]-->
  <string name="paragraph4_text">Paragraph 4. </string>
    <!-- The text of paragraph 5. [CHAR_LIMIT=NONE]-->
  <string name="paragraph5_text">Paragraph 5. </string>
