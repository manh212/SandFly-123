<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Name of the action that pauses Meridian, in the Meridian menu, the gesture action list and the menu settings. [CHAR LIMIT=40] -->
    <string name="title_pause_backtalk">Pause Meridian</string>
    <!-- Summary of the Meridian menu setting that shows the Pause Meridian item. [CHAR LIMIT=NONE] -->
    <string name="summary_pause_backtalk">Turn off speech, gestures and explore by touch until you resume Meridian</string>
    <!-- Keyboard shortcut that pauses Meridian, or resumes it when it is paused. [CHAR LIMIT=40] -->
    <string name="keycombo_menu_global_pause_backtalk">Pause or resume Meridian</string>

    <!-- Spoken when Meridian pauses. [CHAR LIMIT=NONE] -->
    <string name="backtalk_paused">Meridian paused</string>
    <!-- Spoken when Meridian resumes after a pause. [CHAR LIMIT=NONE] -->
    <string name="backtalk_resumed">Meridian resumed</string>

    <!-- Title of the notification shown while Meridian is paused. [CHAR LIMIT=NONE] -->
    <string name="notification_title_backtalk_paused">Meridian is paused</string>
    <!-- Text of the notification shown while Meridian is paused. Tapping it resumes Meridian. [CHAR LIMIT=NONE] -->
    <string name="notification_message_backtalk_paused">Tap to resume</string>
    <!-- Name of the notification channel for the notification shown while Meridian is paused, in the app's notification settings. [CHAR LIMIT=40] -->
    <string name="notification_channel_backtalk_paused">Meridian paused</string>

    <!-- Title of the dialog that asks before pausing Meridian. [CHAR LIMIT=NONE] -->
    <string name="dialog_title_pause_backtalk">Pause Meridian?</string>
    <!-- Button in the dialog that pauses Meridian. [CHAR LIMIT=20] -->
    <string name="dialog_button_pause_backtalk">Pause</string>
    <!-- Message of the dialog that asks before pausing Meridian. [CHAR LIMIT=NONE] -->
    <string name="dialog_message_pause_backtalk">While Meridian is paused, it does not speak or respond to gestures, and the screen works as if no screen reader is on.</string>
    <!-- How to resume Meridian when it resumes at the lock screen. [CHAR LIMIT=NONE] -->
    <string name="message_resume_keyguard">To resume, tap the Meridian is paused notification, press volume down 3 times quickly, or lock and wake the phone so the lock screen shows.</string>
    <!-- How to resume Meridian when it resumes when the screen turns on. [CHAR LIMIT=NONE] -->
    <string name="message_resume_screen_on">To resume, tap the Meridian is paused notification, press volume down 3 times quickly, or turn the screen off and on again.</string>
    <!-- How to resume Meridian when it only resumes from the notification or a shortcut. [CHAR LIMIT=NONE] -->
    <string name="message_resume_manual">To resume, tap the Meridian is paused notification or press volume down 3 times quickly.</string>
    <!-- Added to the pause dialog when a keyboard shortcut is set for pausing and resuming Meridian. [CHAR LIMIT=NONE] -->
    <string name="message_resume_key_combo">You can also press <xliff:g id="key_combo" example="Alt + P">%1$s</xliff:g>.</string>

    <!-- Title of the setting for when Meridian resumes after a pause. [CHAR LIMIT=NONE] -->
    <string name="title_pref_resume_backtalk">Resume Meridian</string>
    <!-- Setting value: Meridian resumes when the lock screen shows. [CHAR LIMIT=NONE] -->
    <string name="value_resume_keyguard">When the lock screen shows</string>
    <!-- Setting value: Meridian resumes when the screen turns on. [CHAR LIMIT=NONE] -->
    <string name="value_resume_screen_on">When the screen turns on</string>
    <!-- Setting value: Meridian resumes only from the notification or a shortcut. [CHAR LIMIT=NONE] -->
    <string name="value_resume_manual">Only from the notification or a shortcut</string>
</resources>
