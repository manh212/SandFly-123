<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Title of the notification and dialog that offer to install Meridian. [CHAR LIMIT=NONE] -->
    <string name="update_move_title">Move to Meridian</string>
    <!-- Text of the notification that offers to install Meridian. [CHAR LIMIT=NONE] -->
    <string name="update_move_notification_text">Install Meridian. Settings and custom labels are copied to it. Tap to install.</string>
    <!-- Message of the dialog that offers to install Meridian. [CHAR LIMIT=NONE] -->
    <string name="update_move_dialog_message">Install Meridian to receive updates. Your settings and custom labels are copied. Then turn on Meridian; the older installation turns off.</string>
    <!-- Announced before the install prompt for Meridian. [CHAR LIMIT=NONE] -->
    <string name="update_move_installing">Installing Meridian. Settings and custom labels are copied to it.</string>
    <!-- Announced when the accessibility settings open after Meridian is installed. [CHAR LIMIT=NONE] -->
    <string name="update_move_turn_on">Turn on Meridian. The older installation then turns off.</string>
    <!-- Shown when the downloaded update is not a build that can be installed. [CHAR LIMIT=NONE] -->
    <string name="update_wrong_package">The download is not a build of this app, so it was not installed</string>
    <!-- Title of the notification that Meridian shows once it took over from the older installation. [CHAR LIMIT=NONE] -->
    <string name="migration_moved_title">Settings copied to Meridian</string>
    <!-- Text of the notification that offers to uninstall the older installation. [CHAR LIMIT=NONE] -->
    <string name="migration_moved_text">Tap to uninstall the older installation.</string>
</resources>
