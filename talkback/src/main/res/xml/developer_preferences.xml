<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:key="@string/pref_category_developer_key">
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:key="@string/pref_developer_version_code_key"
      android:title="@string/title_pref_version_code"
      android:selectable="false" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="@bool/pref_debug_log_default"
      android:key="@string/pref_debug_log_key"
      android:title="@string/title_pref_debug_log" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:key="@string/pref_export_diagnostics_to_downloads_key"
      android:title="@string/title_pref_export_diagnostics_to_downloads" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:key="@string/pref_copy_diagnostics_key"
      android:title="@string/title_pref_copy_diagnostics" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:key="@string/pref_delete_debug_log_key"
      android:title="@string/title_pref_delete_debug_log" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="@bool/pref_tts_overlay_default"
      android:key="@string/pref_tts_overlay_key"
      android:title="@string/title_pref_tts_overlay" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="false"
      android:key="@string/pref_on_device_ai_ignore_memory_limits_key"
      android:title="@string/title_pref_on_device_ai_ignore_memory_limits"
      android:summary="@string/summary_pref_on_device_ai_ignore_memory_limits" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="@bool/pref_multiple_gesture_set_default"
      android:key="@string/pref_multiple_gesture_set_key"
      android:title="@string/title_pref_multiple_gesture_set" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="@bool/pref_echo_recognized_text_default"
      android:key="@string/pref_echo_recognized_text_speech_key"
      android:title="@string/title_pref_echo_recognized_text_speech" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="@bool/pref_explore_by_touch_default"
      android:key="@string/pref_explore_by_touch_reflect_key"
      android:title="@string/title_pref_explore_by_touch" />
</PreferenceScreen>
