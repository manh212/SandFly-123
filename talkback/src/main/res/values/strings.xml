  <!-- The alert dialog button when the user starts the TalkBack tutorial section which needs TalkBack to be active during SUW but TalkBack is inactive, tap it to exit tutorial. [CHAR_LIMIT=30] -->
  <string name="talkback_inactive_exit_tutorial_button">Exit tutorial</string>
  <!-- The button when the user starts the TalkBack tutorial but TalkBack is inactive, tap it cancel the dialog. [CHAR_LIMIT=30] -->
  <string name="talkback_inactive_not_now_button">Not now</string>
  <!-- Alert dialog message when the user starts the TalkBack practice gestures tutorial but TalkBack is inactive, user has to turn on talkback in advance. [CHAR_LIMIT=NONE] -->
