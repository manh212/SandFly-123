<?xml version="1.0" encoding="UTF-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:title="@string/meridian_intro_title"
      android:summary="@string/meridian_intro" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:key="@string/pref_tutorial_entry_point_key"
      android:title="@string/tutorial_entry_point_title" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:key="@string/pref_practice_gestures_entry_point_key"
      android:title="@string/practice_gestures_title" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:title="@string/meridian_contact_title">
    <intent
        android:action="android.intent.action.VIEW"
        android:data="https://www.facebook.com/share/1Bscgg2MPs/" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreference>
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory
      android:key="pref_category_diagnostics"
      android:title="@string/title_pref_diagnostics_section">
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="@bool/pref_debug_log_default"
        android:key="@string/pref_debug_log_key"
        android:title="@string/title_pref_debug_log" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:key="@string/pref_delete_debug_log_key"
        android:title="@string/title_pref_delete_debug_log" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:key="@string/pref_export_diagnostics_to_downloads_key"
        android:title="@string/title_pref_export_diagnostics_to_downloads" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:key="@string/pref_copy_diagnostics_key"
        android:title="@string/title_pref_copy_diagnostics" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
</PreferenceScreen>
