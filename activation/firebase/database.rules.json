{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "requests": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && auth.uid === $uid && !data.exists() && !root.child('decisions').child($uid).exists() && newData.exists()",
        ".validate": "newData.hasChildren(['request', 'name', 'description', 'createdAt'])",
        "request": {
          ".validate": "newData.isString() && newData.val().matches(/^SFREQ2\\.[0-9a-f]{64}$/)"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
        },
        "description": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 1000"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "decisions": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && root.child('requests').child($uid).exists() && newData.exists()",
        ".validate": "newData.hasChildren(['request', 'state', 'policy', 'decidedAt'])",
        "request": {
          ".validate": "newData.val() === root.child('requests').child($uid).child('request').val()"
        },
        "state": {
          ".validate": "newData.val() === 'approved' || newData.val() === 'rejected'"
        },
        "policy": {
          ".validate": "newData.isString() && newData.val().length <= 2048 && (newData.parent().child('state').val() === 'rejected' || newData.val().beginsWith('SFLIC3.'))"
        },
        "decidedAt": {
          ".validate": "newData.isNumber() && newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "devices": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$device": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "$device.matches(/^[0-9a-f]{64}$/) && newData.hasChildren(['request', 'name', 'description', 'value'])",
        "request": {
          ".validate": "newData.val() === 'SFREQ2.' + $device"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "description": {
          ".validate": "newData.isString() && newData.val().length <= 1000"
        },
        "value": {
          ".validate": "newData.isString() && newData.val().length <= 2048"
        },
        "uid": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "supportStaff": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (auth != null && root.child('admins').child(auth.uid).val() === true))",
        ".write": "(auth != null && root.child('admins').child(auth.uid).val() === true) && newData.exists()",
        ".validate": "newData.hasChildren(['name', 'enabled'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
        },
        "enabled": {
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": "false"
        }
      }
    },
    "supportIndex": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('supportStaff').child(auth.uid).child('enabled').val() === true)",
      ".indexOn": [
        "lastAt",
        "createdAt"
      ],
      "$ticket": {
        ".read": "(auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('supportStaff').child(auth.uid).child('enabled').val() === true)) || (auth != null && root.child('supportIndex').child($ticket).child('owner').val() === auth.uid) || (auth != null && !data.exists())",
        ".write": "auth != null && !data.exists() && newData.child('owner').val() === auth.uid && newData.exists()",
        ".validate": "$ticket.matches(/^[0-9]{13}-[0-9a-f]{20}$/) && newData.hasChildren(['owner','name','subject','type','request','appVersion','androidVersion','createdAt','lastAt'])",
        "owner": {
          ".validate": "newData.isString() && (data.exists() ? newData.val() === data.val() : newData.val() === auth.uid)"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "subject": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 160"
        },
        "type": {
          ".validate": "newData.val() === 'feedback' || newData.val() === 'bug' || newData.val() === 'log'"
        },
        "request": {
          ".validate": "newData.isString() && newData.val().matches(/^SFREQ2\\.[0-9a-f]{64}$/)"
        },
        "appVersion": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
        },
        "androidVersion": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : newData.val() === now)"
        },
        "lastAt": {
          ".write": "((auth != null && root.child('supportIndex').child($ticket).child('owner').val() === auth.uid) || (auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('supportStaff').child(auth.uid).child('enabled').val() === true))) && newData.exists()",
          ".validate": "newData.isNumber() && newData.val() === now"
        },
        "$other": {
          ".validate": "false"
        }
      }
    },
    "supportUsers": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('supportStaff').child(auth.uid).child('enabled').val() === true)))",
        "$ticket": {
          ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('supportIndex').child($ticket).child('owner').val() === $uid && newData.exists()",
          ".validate": "newData.hasChildren(['subject','type','createdAt'])",
          "subject": {
            ".validate": "newData.val() === root.child('supportIndex').child($ticket).child('subject').val()"
          },
          "type": {
            ".validate": "newData.val() === root.child('supportIndex').child($ticket).child('type').val()"
          },
          "createdAt": {
            ".validate": "newData.val() === root.child('supportIndex').child($ticket).child('createdAt').val()"
          },
          "$other": {
            ".validate": "false"
          }
        }
      }
    },
    "supportMessages": {
      "$ticket": {
        ".read": "(auth != null && root.child('supportIndex').child($ticket).child('owner').val() === auth.uid) || (auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('supportStaff').child(auth.uid).child('enabled').val() === true))",
        "$message": {
          ".write": "((auth != null && root.child('supportIndex').child($ticket).child('owner').val() === auth.uid) || (auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('supportStaff').child(auth.uid).child('enabled').val() === true))) && !data.exists() && newData.exists() && root.child('supportIndex').child($ticket).exists()",
          ".validate": "$message.matches(/^[0-9]{13}-[0-9a-f]{20}$/) && newData.hasChildren(['uid','name','kind','text','log','createdAt']) && (newData.child('text').val().length > 0 || newData.child('log').val().length > 0 || newData.child('logBytes').val() > 0) && (newData.hasChild('logBytes') === newData.hasChild('logSha256')) && (!newData.hasChild('logBytes') || (root.child('supportAttachments').child($ticket).child($message).child('uid').val() === auth.uid && ((root.child('supportAttachments').child($ticket).child($message).child('parts').val() <= 0 || root.child('supportLogChunks').child($ticket).child($message).child('chunk0').exists()) && (root.child('supportAttachments').child($ticket).child($message).child('parts').val() <= 1 || root.child('supportLogChunks').child($ticket).child($message).child('chunk1').exists()) && (root.child('supportAttachments').child($ticket).child($message).child('parts').val() <= 2 || root.child('supportLogChunks').child($ticket).child($message).child('chunk2').exists()) && (root.child('supportAttachments').child($ticket).child($message).child('parts').val() <= 3 || root.child('supportLogChunks').child($ticket).child($message).child('chunk3').exists()) && (root.child('supportAttachments').child($ticket).child($message).child('parts').val() <= 4 || root.child('supportLogChunks').child($ticket).child($message).child('chunk4').exists()) && (root.child('supportAttachments').child($ticket).child($message).child('parts').val() <= 5 || root.child('supportLogChunks').child($ticket).child($message).child('chunk5').exists()) && (root.child('supportAttachments').child($ticket).child($message).child('parts').val() <= 6 || root.child('supportLogChunks').child($ticket).child($message).child('chunk6').exists()) && (root.child('supportAttachments').child($ticket).child($message).child('parts').val() <= 7 || root.child('supportLogChunks').child($ticket).child($message).child('chunk7').exists()) && (root.child('supportAttachments').child($ticket).child($message).child('parts').val() <= 8 || root.child('supportLogChunks').child($ticket).child($message).child('chunk8').exists()) && (root.child('supportAttachments').child($ticket).child($message).child('parts').val() <= 9 || root.child('supportLogChunks').child($ticket).child($message).child('chunk9').exists()) && (root.child('supportAttachments').child($ticket).child($message).child('parts').val() <= 10 || root.child('supportLogChunks').child($ticket).child($message).child('chunk10').exists()) && (root.child('supportAttachments').child($ticket).child($message).child('parts').val() <= 11 || root.child('supportLogChunks').child($ticket).child($message).child('chunk11').exists()) && (root.child('supportAttachments').child($ticket).child($message).child('parts').val() <= 12 || root.child('supportLogChunks').child($ticket).child($message).child('chunk12').exists()) && (root.child('supportAttachments').child($ticket).child($message).child('parts').val() <= 13 || root.child('supportLogChunks').child($ticket).child($message).child('chunk13').exists()) && (root.child('supportAttachments').child($ticket).child($message).child('parts').val() <= 14 || root.child('supportLogChunks').child($ticket).child($message).child('chunk14').exists()) && (root.child('supportAttachments').child($ticket).child($message).child('parts').val() <= 15 || root.child('supportLogChunks').child($ticket).child($message).child('chunk15').exists()) && (root.child('supportAttachments').child($ticket).child($message).child('parts').val() <= 16 || root.child('supportLogChunks').child($ticket).child($message).child('chunk16').exists()) && (root.child('supportAttachments').child($ticket).child($message).child('parts').val() <= 17 || root.child('supportLogChunks').child($ticket).child($message).child('chunk17').exists()) && (root.child('supportAttachments').child($ticket).child($message).child('parts').val() <= 18 || root.child('supportLogChunks').child($ticket).child($message).child('chunk18').exists()) && (root.child('supportAttachments').child($ticket).child($message).child('parts').val() <= 19 || root.child('supportLogChunks').child($ticket).child($message).child('chunk19').exists()))))",
          "uid": {
            ".validate": "newData.val() === auth.uid"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "kind": {
            ".validate": "(newData.val() === 'user' && (auth != null && root.child('supportIndex').child($ticket).child('owner').val() === auth.uid)) || (newData.val() === 'staff' && (auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('supportStaff').child(auth.uid).child('enabled').val() === true)))"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length <= 8000"
          },
          "log": {
            ".validate": "newData.isString() && newData.val().length <= 32000"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() === now"
          },
          "$other": {
            ".validate": "false"
          },
          "logBytes": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10485760 && newData.val() === root.child('supportAttachments').child($ticket).child($message).child('bytes').val() && newData.parent().child('log').val() === ''"
          },
          "logSha256": {
            ".validate": "newData.isString() && newData.val() === root.child('supportAttachments').child($ticket).child($message).child('sha256').val()"
          }
        }
      }
    },
    "supportStates": {
      "$ticket": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('supportStaff').child(auth.uid).child('enabled').val() === true)",
        ".write": "(auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('supportStaff').child(auth.uid).child('enabled').val() === true)) && root.child('supportIndex').child($ticket).exists() && newData.exists()",
        ".validate": "newData.hasChildren(['state','by','name','changedAt'])",
        "state": {
          ".validate": "newData.val() === 'new' || newData.val() === 'working' || newData.val() === 'need_info' || newData.val() === 'resolved'"
        },
        "by": {
          ".validate": "newData.val() === auth.uid"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "changedAt": {
          ".validate": "newData.isNumber() && newData.val() === now"
        },
        "$other": {
          ".validate": "false"
        }
      }
    },
    "supportContacts": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": [
        "request"
      ],
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (auth != null && root.child('admins').child(auth.uid).val() === true) || ((auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('supportStaff').child(auth.uid).child('enabled').val() === true)) && root.child('supportUsers').child($uid).exists()))",
        ".write": "auth != null && auth.uid === $uid && newData.exists()",
        ".validate": "newData.hasChildren(['request','lastSeen'])",
        "request": {
          ".validate": "newData.isString() && newData.val().matches(/^SFREQ2\\.[0-9a-f]{64}$/) && (!data.exists() || newData.val() === data.val())"
        },
        "lastSeen": {
          ".validate": "newData.isNumber() && newData.val() === now"
        },
        "$other": {
          ".validate": "false"
        }
      }
    },
    "supportAttachments": {
      "$ticket": {
        "$message": {
          ".read": "(auth != null && root.child('supportIndex').child($ticket).child('owner').val() === auth.uid) || (auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('supportStaff').child(auth.uid).child('enabled').val() === true))",
          ".write": "(auth != null && root.child('supportIndex').child($ticket).child('owner').val() === auth.uid) && !data.exists() && newData.exists() && !root.child('supportMessages').child($ticket).child($message).exists()",
          ".validate": "$message.matches(/^[0-9]{13}-[0-9a-f]{20}$/) && newData.hasChildren(['uid','bytes','sha256','parts','createdAt'])",
          "uid": {
            ".validate": "newData.val() === auth.uid"
          },
          "bytes": {
            ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 10485760"
          },
          "sha256": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{64}$/)"
          },
          "parts": {
            ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 20 && newData.parent().child('bytes').val() > (newData.val() - 1) * 524288 && newData.parent().child('bytes').val() <= newData.val() * 524288"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "supportLogChunks": {
      "$ticket": {
        "$message": {
          "$chunk": {
            ".read": "(auth != null && root.child('supportIndex').child($ticket).child('owner').val() === auth.uid) || (auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('supportStaff').child(auth.uid).child('enabled').val() === true))",
            ".write": "(auth != null && root.child('supportIndex').child($ticket).child('owner').val() === auth.uid) && !data.exists() && newData.exists() && root.child('supportAttachments').child($ticket).child($message).child('uid').val() === auth.uid && !root.child('supportMessages').child($ticket).child($message).exists()",
            ".validate": "newData.hasChildren(['index','bytes','data']) && $chunk === 'chunk' + newData.child('index').val()",
            "index": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() < root.child('supportAttachments').child($ticket).child($message).child('parts').val()"
            },
            "bytes": {
              ".validate": "newData.isNumber() && newData.val() === (newData.parent().child('index').val() < root.child('supportAttachments').child($ticket).child($message).child('parts').val() - 1 ? 524288 : root.child('supportAttachments').child($ticket).child($message).child('bytes').val() - newData.parent().child('index').val() * 524288)"
            },
            "data": {
              ".validate": "newData.isString() && newData.val().length === ((newData.parent().child('bytes').val() - newData.parent().child('bytes').val() % 3) / 3 + (newData.parent().child('bytes').val() % 3 === 0 ? 0 : 1)) * 4 && newData.val().length <= 699052"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
