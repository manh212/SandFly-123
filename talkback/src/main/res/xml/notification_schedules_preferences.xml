<?xml version="1.0" encoding="utf-8"?>
<!-- Notifications > Summary: notifications read together. The time announcements are in Timer settings. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory android:title="@string/notification_category_summary">
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:key="pref_notification_access"
        android:title="@string/notification_list_grant_access" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:key="pref_notification_summary_now"
        android:title="@string/notification_summary_now_title" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="false"
        android:key="pref_notification_summary_daily"
        android:title="@string/notification_summary_daily_title" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:dependency="pref_notification_summary_daily"
        android:key="pref_notification_summary_time"
        android:title="@string/notification_summary_time_title" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="false"
        android:key="pref_notification_summary_newest_first"
        android:title="@string/notification_summary_newest_first_title" />
    <EditTextPreference
        android:key="pref_notification_summary_name"
        android:title="@string/notification_summary_name_title"
        app:useSimpleSummaryProvider="true" />
    <ListPreference
        android:defaultValue="0"
        android:key="pref_notification_summary_gap"
        android:summary="%s"
        android:title="@string/notification_summary_gap_title" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
</PreferenceScreen>
